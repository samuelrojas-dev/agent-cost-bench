# Copy to .env and fill in. Never commit .env.
# Not needed for the mock provider (tests, development, quickstart).
ANTHROPIC_API_KEY=
# Only GEMINI_API_KEY is read for Gemini; GOOGLE_API_KEY and Vertex settings are ignored.
GEMINI_API_KEY=
# Only OPENAI_API_KEY is read for OpenAI; a set OPENAI_BASE_URL is refused (it could redirect the key).
OPENAI_API_KEY=
